{
  "name": "computer-use-capabilities",
  "version": "0.1.0",
  "description": "Discover-once, replay-many computer-use automation system for legacy back-office UIs with no API.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mock-app": "tsx mock-app/server.ts",
    "discover": "tsx --env-file-if-exists=.env src/cli/index.ts discover",
    "replay": "tsx --env-file-if-exists=.env src/cli/index.ts replay",
    "invoke": "tsx --env-file-if-exists=.env src/cli/index.ts invoke",
    "list-capabilities": "tsx src/cli/index.ts list-capabilities",
    "stability-check": "tsx src/cli/index.ts stability-check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "zod": "^3.23.8",
    "groq-sdk": "^0.7.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
